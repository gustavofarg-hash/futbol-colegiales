rules_version = '2';

// Acceso por cuenta. El mail de abajo es el mismo que ADMIN_EMAIL en
// config.js, en minúsculas. La regla lo compara sin distinguir mayúsculas.
// Si volviera a decir TU_EMAIL_ADMIN, nadie podría crear al admin.
//
// Orden seguro: activar Email/Password, poner el mail, crear la cuenta de
// admin (con las reglas viejas todavía publicadas, o con estas: el alta del
// admin sigue permitida) y recién ahí publicar. Publicar esto no borra datos.
//
// La única diferencia de rol en la app: el admin crea, desactiva y borra
// organizadores. Nadie cambia el rol desde la pantalla de un partido.
// Para backup, carga y reset, el admin activo sí puede leer y escribir
// cualquier documento, incluidas subcolecciones. Un organizador no.
// Sin viewers, o con `*`, lo ven todos los activos. Con una lista de uids,
// solo esas cuentas (y el creador) lo leen. Quien no está en adders lo ve
// y no anota. Sin sesión no hay escrituras, salvo confirmed/confirmedAt
// con el token.
service cloud.firestore {
  match /databases/{database}/documents {

    function adminEmail() {
      return 'gustavof.arg@gmail.com';
    }
    function signedIn() {
      return request.auth != null;
    }
    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }
    function isAdminEmail() {
      return signedIn()
          && adminEmail() != 'TU_EMAIL_ADMIN'
          && adminEmail().size() > 3
          && request.auth.token.email is string
          && request.auth.token.email.lower() == adminEmail().lower();
    }
    function hasUser() {
      return signedIn() && exists(userPath(request.auth.uid));
    }
    function userData() {
      return get(userPath(request.auth.uid)).data;
    }
    function isActiveStaff() {
      return hasUser()
          && userData().active == true
          && (userData().role == 'admin' || userData().role == 'organizer');
    }
    function isAdmin() {
      return isActiveStaff() && userData().role == 'admin';
    }

    function validMatch(d) {
      return d.date is string && d.date.matches('^\\d{4}-\\d{2}-\\d{2}$')
          && d.time is string && d.time.matches('^\\d{2}:\\d{2}$')
          && (!('note' in d) || (d.note is string && d.note.size() <= 300))
          && (!('notes' in d) || (d.notes is string && d.notes.size() <= 2000))
          && (!('cancelled' in d) || d.cancelled is bool)
          && (!('cancelledAt' in d) || d.cancelledAt == null || d.cancelledAt is number)
          && (!('cancelledBy' in d) || d.cancelledBy == null || (d.cancelledBy is string && d.cancelledBy.size() <= 128))
          && (!('playerCount' in d) || (d.playerCount is int && d.playerCount >= 0 && d.playerCount <= 500))
          && (!('venueId' in d) || (d.venueId is string && d.venueId.size() > 0 && d.venueId.size() <= 40 && d.venueId.matches('^[a-z0-9][a-z0-9-]{0,39}$')))
          && (!('venueName' in d) || (d.venueName is string && d.venueName.size() > 0 && d.venueName.size() <= 80))
          && (!('perTeam' in d) || (d.perTeam is int && d.perTeam >= 5 && d.perTeam <= 11))
          && (!('capacity' in d) || (d.capacity is int && d.capacity >= 1 && d.capacity <= 40))
          && (!('perTeam' in d) || !('capacity' in d) || d.capacity == d.perTeam * 2)
          && (!('court' in d) || (d.court is string && d.court.size() <= 20))
          && (!('price' in d) || (d.price is int && d.price >= 0 && d.price <= 1000000000))
          && (!('score' in d) || scoreOk(d.score))
          && accessShape(d);
    }
    function scoreOk(s) {
      return s is map
          && s.keys().hasOnly(['bib', 'plain'])
          && s.bib is int && s.bib >= 0 && s.bib <= 999
          && s.plain is int && s.plain >= 0 && s.plain <= 999;
    }
    function accessShape(d) {
      return (!('viewers' in d) || (d.viewers is list && d.viewers.size() > 0 && d.viewers.size() <= 30))
          && (!('adders' in d) || (d.adders is list && d.adders.size() > 0 && d.adders.size() <= 30))
          && (!('solo' in d) || d.solo is bool)
          && (!('createdByUid' in d) || (d.createdByUid is string && d.createdByUid.size() <= 128))
          && (!('limits' in d) || (d.limits is list && d.limits.size() <= 30))
          && (!('viewerNames' in d) || d.viewerNames is list)
          && (!('adderNames' in d) || d.adderNames is list);
    }
    function isPublic(d) {
      return !('viewers' in d) || d.viewers == null || (d.viewers is list && d.viewers.hasAny(['*']));
    }
    function isViewer(d) {
      return isPublic(d) || (d.viewers is list && (d.viewers.hasAny([request.auth.uid]) || d.createdByUid == request.auth.uid));
    }
    function isAdder(d) {
      return isViewer(d) && (
        !('adders' in d) || d.adders == null
        || (d.adders is list && (d.adders.hasAny(['*']) || d.adders.hasAny([request.auth.uid]) || d.createdByUid == request.auth.uid))
      );
    }
    function accessSame() {
      return request.resource.data.get('viewers', null) == resource.data.get('viewers', null)
          && request.resource.data.get('adders', null) == resource.data.get('adders', null)
          && request.resource.data.get('solo', null) == resource.data.get('solo', null)
          && request.resource.data.get('createdByUid', null) == resource.data.get('createdByUid', null)
          && request.resource.data.get('limits', null) == resource.data.get('limits', null);
    }
    function isCreator() {
      return resource.data.createdByUid == request.auth.uid;
    }
    function legacyStamp() {
      return !('viewers' in resource.data)
          && request.resource.data.viewers is list
          && request.resource.data.viewers.hasAny(['*'])
          && request.resource.data.solo != true;
    }
    function matchData(matchId) {
      return get(/databases/$(database)/documents/matches/$(matchId)).data;
    }
    function playerListsOk(matchId) {
      let m = matchData(matchId);
      return isPublic(m) || (
        request.resource.data.viewers is list
        && !request.resource.data.viewers.hasAny(['*'])
        && m.viewers is list
        && request.resource.data.viewers.hasAll(m.viewers)
        && m.viewers.hasAll(request.resource.data.viewers)
      );
    }
    function canReadListed(d) {
      return !('viewers' in d) || d.viewers == null || (d.viewers is list && d.viewers.hasAny([request.auth.uid, '*']));
    }
    function playerAccessUnchanged() {
      return request.resource.data.get('viewers', null) == resource.data.get('viewers', null)
          && request.resource.data.get('adders', null) == resource.data.get('adders', null);
    }
    function playerFollowsMatch() {
      let m = matchData(resource.data.matchId);
      return isAdder(m)
          && request.resource.data.get('viewers', null) == m.get('viewers', null)
          && request.resource.data.get('adders', null) == m.get('adders', null);
    }
    function confirmationViewersOk() {
      return request.resource.data.get('viewers', null) == resource.data.get('viewers', null)
          || (
            !('viewers' in resource.data)
            && request.resource.data.viewers is list
            && request.resource.data.viewers.size() == 1
            && request.resource.data.viewers.hasAny(['*'])
          )
          || (
            request.resource.data.viewers == matchData(resource.data.matchId).get('viewers', null)
            && isAdder(matchData(resource.data.matchId))
          );
    }

    // Los campos del jugador, por grupo. validPayment sigue siendo todo junto
    // (el alta). El update valida cada grupo solo si cambió.
    function moneyKeys() {
      return ['paid', 'amount', 'method', 'paidUpdatedBy', 'paidUpdatedAt', 'receivedBy',
          'cash', 'transfer', 'pendingTransfer', 'transferReceivedAt', 'transferReceivedBy',
          'cashTo', 'transferTo', 'pendingTo', 'transferParts', 'freePlay'];
    }
    function waitKeys() {
      return ['waiting', 'waitOrder', 'rosterAt', 'tentative', 'tentativeAt'];
    }
    function confirmKeys() {
      return ['confirmToken', 'confirmed', 'confirmedAt', 'reminderSentAt'];
    }
    function goalKeys() {
      return ['goals', 'inGoal', 'inGoalAt'];
    }
    function stampKeys() {
      return ['viewers', 'adders', 'addedByUid', 'signedUpWith', 'signedUpWithName'];
    }
    function validPayment(d) {
      return validMoney(d) && validPlayerState(d);
    }
    function validMoney(d) {
      return (!('paid' in d) || d.paid is bool)
          && (!('amount' in d) || d.amount == null || (d.amount is number && d.amount >= 0 && d.amount <= 1000000000))
          && (!('method' in d) || d.method == null || d.method == 'efectivo' || d.method == 'transferencia')
          && (!('paidUpdatedBy' in d) || (d.paidUpdatedBy is string && d.paidUpdatedBy.size() <= 40))
          && (!('paidUpdatedAt' in d) || d.paidUpdatedAt is number)
          && (!('receivedBy' in d) || d.receivedBy == null || (d.receivedBy is string && d.receivedBy.size() > 0 && d.receivedBy.size() <= 40))
          && (!('cash' in d) || d.cash == null || (d.cash is number && d.cash >= 0 && d.cash <= 1000000000))
          && (!('transfer' in d) || d.transfer == null || (d.transfer is number && d.transfer >= 0 && d.transfer <= 1000000000))
          && (!('pendingTransfer' in d) || d.pendingTransfer == null || (d.pendingTransfer is number && d.pendingTransfer >= 0 && d.pendingTransfer <= 1000000000))
          && (!('transferReceivedAt' in d) || d.transferReceivedAt == null || d.transferReceivedAt is number)
          && (!('transferReceivedBy' in d) || d.transferReceivedBy == null || (d.transferReceivedBy is string && d.transferReceivedBy.size() > 0 && d.transferReceivedBy.size() <= 40))
          && (!('cashTo' in d) || d.cashTo == null || (d.cashTo is string && d.cashTo.size() > 0 && d.cashTo.size() <= 40))
          && (!('transferTo' in d) || d.transferTo == null || (d.transferTo is string && d.transferTo.size() > 0 && d.transferTo.size() <= 40))
          && (!('pendingTo' in d) || d.pendingTo == null || (d.pendingTo is string && d.pendingTo.size() > 0 && d.pendingTo.size() <= 40))
          && (!('transferParts' in d) || d.transferParts == null || transferPartsOk(d.transferParts))
          && (!('freePlay' in d) || d.freePlay is bool);
    }
    function validPlayerState(d) {
      return validWait(d) && validConfirm(d) && validGoals(d) && validStamp(d);
    }
    function validWait(d) {
      return (!('waiting' in d) || d.waiting is bool)
          && (!('waitOrder' in d) || d.waitOrder == null || (d.waitOrder is number && d.waitOrder >= 0 && d.waitOrder <= 1000000))
          && (!('rosterAt' in d) || d.rosterAt == null || d.rosterAt is number)
          && (!('tentative' in d) || d.tentative == null || d.tentative is bool)
          && (!('tentativeAt' in d) || d.tentativeAt == null || d.tentativeAt is number);
    }
    function validConfirm(d) {
      return (!('confirmToken' in d) || (d.confirmToken is string && d.confirmToken.size() >= 16 && d.confirmToken.size() <= 80))
          && (!('confirmed' in d) || d.confirmed == null || d.confirmed == 'si' || d.confirmed == 'no')
          && (!('confirmedAt' in d) || d.confirmedAt == null || d.confirmedAt is number)
          && (!('reminderSentAt' in d) || d.reminderSentAt == null || d.reminderSentAt is number);
    }
    function validGoals(d) {
      return (!('goals' in d) || (d.goals is int && d.goals >= 0 && d.goals <= 99))
          && (!('inGoal' in d) || d.inGoal is bool)
          && (!('inGoalAt' in d) || d.inGoalAt == null || d.inGoalAt is number);
    }
    function validStamp(d) {
      return (!('viewers' in d) || (d.viewers is list && d.viewers.size() > 0 && d.viewers.size() <= 30))
          && (!('adders' in d) || (d.adders is list && d.adders.size() > 0 && d.adders.size() <= 30))
          && (!('addedByUid' in d) || (d.addedByUid is string && d.addedByUid.size() <= 128))
          && (!('signedUpWith' in d) || (d.signedUpWith is string && d.signedUpWith.size() > 0 && d.signedUpWith.size() <= 128))
          && (!('signedUpWithName' in d) || (d.signedUpWithName is string && d.signedUpWithName.size() > 0 && d.signedUpWithName.size() <= 40));
    }

    function transferPartOk(p) {
      return p is map
          && p.keys().hasOnly(['to', 'amount'])
          && p.to is string && p.to.size() > 0 && p.to.size() <= 40
          && p.amount is number && p.amount >= 0 && p.amount <= 1000000000;
    }
    function transferPartsOk(p) {
      return p is list && p.size() >= 1 && p.size() <= 6
          && (p.size() < 1 || transferPartOk(p[0]))
          && (p.size() < 2 || transferPartOk(p[1]))
          && (p.size() < 3 || transferPartOk(p[2]))
          && (p.size() < 4 || transferPartOk(p[3]))
          && (p.size() < 5 || transferPartOk(p[4]))
          && (p.size() < 6 || transferPartOk(p[5]));
    }
    function priceOk(n) {
      return n is int && n >= 0 && n <= 1000000000;
    }
    function validPrices(d) {
      return d.keys().hasOnly(['matchPrice', 'promo2Price', 'promo3Price'])
          && priceOk(d.matchPrice) && priceOk(d.promo2Price) && priceOk(d.promo3Price);
    }

    // El nombre del organizador, en minúsculas. Sin uid de creador, el
    // jugador viejo se edita solo si ese nombre coincide. No pliega tildes:
    // las reglas no tienen el mismo plegado que la app.
    function creatorNameIs(stored) {
      return stored is string
          && stored.size() > 0
          && stored.size() <= 40
          && userData().name is string
          && stored.lower() == userData().name.lower();
    }
    function isPlayerCreator() {
      return resource.data.get('addedByUid', '') == request.auth.uid
          || (
            resource.data.get('addedByUid', '') == ''
            && creatorNameIs(resource.data.get('addedBy', ''))
          );
    }
    function isRosterCreator() {
      return resource.data.get('createdByUid', '') == request.auth.uid
          || (
            resource.data.get('createdByUid', '') == ''
            && creatorNameIs(resource.data.get('createdBy', ''))
          );
    }
    function playerStampSame() {
      return request.resource.data.get('addedBy', null) == resource.data.get('addedBy', null)
          && request.resource.data.get('addedByUid', null) == resource.data.get('addedByUid', null);
    }
    function playerNameSame() {
      return request.resource.data.name == resource.data.name;
    }
    function playerPhoneMetaSame() {
      return request.resource.data.get('phoneKey', null) == resource.data.get('phoneKey', null)
          && request.resource.data.get('hasPhone', null) == resource.data.get('hasPhone', null)
          && request.resource.data.get('phoneOwnerUid', null) == resource.data.get('phoneOwnerUid', null);
    }
    // Un jugador viejo todavía tiene el teléfono en el documento. Sacarlo
    // (la migración) puede ir junto con un pago o la espera. El nombre no
    // se toca y el dueño del número queda el que lo agregó.
    function legacyPhoneMoveOk() {
      return resource.data.get('phone', '') is string
          && resource.data.get('phone', '').size() > 0
          && request.resource.data.get('phone', '') == ''
          && playerNameSame()
          && (
            request.resource.data.get('phoneOwnerUid', '') == resource.data.get('addedByUid', '')
            || (
              resource.data.get('addedByUid', '') == ''
              && request.resource.data.get('phoneOwnerUid', '') == request.auth.uid
              && creatorNameIs(resource.data.get('addedBy', ''))
            )
          );
    }
    function rosterStampSame() {
      return request.resource.data.get('createdBy', null) == resource.data.get('createdBy', null)
          && request.resource.data.get('createdByUid', null) == resource.data.get('createdByUid', null)
          && request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null);
    }
    function rosterIdentitySame() {
      return request.resource.data.get('name', null) == resource.data.get('name', null)
          && request.resource.data.get('phoneKey', null) == resource.data.get('phoneKey', null)
          && request.resource.data.get('hasPhone', null) == resource.data.get('hasPhone', null)
          && request.resource.data.get('phoneOwnerUid', null) == resource.data.get('phoneOwnerUid', null)
          && request.resource.data.get('level', null) == resource.data.get('level', null)
          && request.resource.data.get('positions', null) == resource.data.get('positions', null)
          && request.resource.data.get('notes', null) == resource.data.get('notes', null)
          && request.resource.data.get('shortName', null) == resource.data.get('shortName', null);
    }

    // Un organizador puede actualizar al jugador. El nombre y el teléfono
    // los cambia solo quien lo agregó. Si toca la respuesta, solo puede
    // cambiar esos campos y el token queda igual. El admin no es excepción.
    function confirmationWriteOk() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return !changed.hasAny(['confirmed', 'confirmedAt'])
          || (changed.hasOnly(['confirmed', 'confirmedAt', 'updatedAt'])
              && request.resource.data.confirmToken == resource.data.confirmToken
              && request.resource.data.confirmToken is string
              && request.resource.data.confirmToken.size() >= 16
              && (request.resource.data.confirmed == 'si' || request.resource.data.confirmed == 'no')
              && request.resource.data.confirmedAt is number);
    }

    function phoneGone(d) {
      return !('phone' in d) || d.phone == '';
    }
    function phoneKeyOk(v) {
      return v is string && (v.size() == 0 || (v.size() == 64 && v.matches('^[0-9a-f]{64}$')));
    }
    function phoneMeta(d) {
      return (!('phoneKey' in d) || phoneKeyOk(d.phoneKey))
          && (!('hasPhone' in d) || d.hasPhone is bool)
          && (!('phoneShared' in d) || d.phoneShared is bool)
          && (!('phoneOwnerUid' in d) || (d.phoneOwnerUid is string && d.phoneOwnerUid.size() <= 128));
    }
    function validPlayer(d) {
      return validPlayerShape(d) && validPayment(d);
    }
    // Un update no vuelve a validar todo el documento: con un invitado con
    // pago, validarlo entero más el resto de la regla pasaba el tope de 1000
    // expresiones por request y Firestore lo negaba (también al admin). Lo
    // que no cambia ya pasó estas mismas reglas al escribirse.
    function validPlayerUpdate() {
      let d = request.resource.data;
      let changed = d.diff(resource.data).affectedKeys();
      return d.matchId is string && d.name is string
          && d.name.size() > 0 && d.name.size() <= 60
          && phoneGone(d)
          && (!changed.hasAny(['matchId', 'name', 'phone', 'phoneKey', 'hasPhone', 'phoneShared', 'phoneOwnerUid',
              'shortCode', 'invitedBy', 'invitedByName', 'shortName']) || validPlayerShape(d))
          && (!changed.hasAny(moneyKeys()) || validMoney(d))
          && (!changed.hasAny(waitKeys()) || validWait(d))
          && (!changed.hasAny(confirmKeys()) || validConfirm(d))
          && (!changed.hasAny(goalKeys()) || validGoals(d))
          && (!changed.hasAny(stampKeys()) || validStamp(d));
    }
    function validPlayerShape(d) {
      return d.matchId is string && d.name is string
          && d.name.size() > 0 && d.name.size() <= 60
          && phoneGone(d)
          && phoneMeta(d)
          && (!('shortCode' in d) || (d.shortCode is string && d.shortCode.matches('^[0-9A-Za-z]{8}$')))
          && (!('invitedBy' in d) || (d.invitedBy is string && d.invitedBy.size() > 0 && d.invitedBy.size() <= 128))
          && (!('invitedByName' in d) || (d.invitedByName is string && d.invitedByName.size() > 0 && d.invitedByName.size() <= 60))
          && (!('shortName' in d) || (d.shortName is string && d.shortName.size() <= 40));
    }

    function posOk(x) {
      return x == 'Arquero' || x == 'Defensa' || x == 'Mediocampo' || x == 'Ataque';
    }
    function positionsOk(p) {
      return p is list && p.size() <= 4
          && (p.size() < 1 || posOk(p[0]))
          && (p.size() < 2 || posOk(p[1]))
          && (p.size() < 3 || posOk(p[2]))
          && (p.size() < 4 || posOk(p[3]));
    }
    function noteOk(n) {
      return n is map
          && n.id is string && n.id.size() > 0 && n.id.size() <= 40
          && n.matchId is string && n.matchId.size() > 0 && n.matchId.size() <= 80
          && n.text is string && n.text.size() > 0 && n.text.size() <= 400
          && n.createdAt is number
          && (!('matchDate' in n) || (n.matchDate is string && n.matchDate.size() <= 10))
          && (!('matchTime' in n) || (n.matchTime is string && n.matchTime.size() <= 5))
          && (!('updatedAt' in n) || n.updatedAt is number);
    }
    function notesOk(n) {
      return n is list && n.size() <= 20
          && (n.size() < 1 || noteOk(n[0])) && (n.size() < 2 || noteOk(n[1]))
          && (n.size() < 3 || noteOk(n[2])) && (n.size() < 4 || noteOk(n[3]))
          && (n.size() < 5 || noteOk(n[4])) && (n.size() < 6 || noteOk(n[5]))
          && (n.size() < 7 || noteOk(n[6])) && (n.size() < 8 || noteOk(n[7]))
          && (n.size() < 9 || noteOk(n[8])) && (n.size() < 10 || noteOk(n[9]))
          && (n.size() < 11 || noteOk(n[10])) && (n.size() < 12 || noteOk(n[11]))
          && (n.size() < 13 || noteOk(n[12])) && (n.size() < 14 || noteOk(n[13]))
          && (n.size() < 15 || noteOk(n[14])) && (n.size() < 16 || noteOk(n[15]))
          && (n.size() < 17 || noteOk(n[16])) && (n.size() < 18 || noteOk(n[17]))
          && (n.size() < 19 || noteOk(n[18])) && (n.size() < 20 || noteOk(n[19]));
    }
    function validRoster(d) {
      return d.name is string && d.name.size() > 0 && d.name.size() <= 60
          && phoneGone(d)
          && phoneMeta(d)
          && (!('createdBy' in d) || (d.createdBy is string && d.createdBy.size() <= 40))
          && (!('createdByUid' in d) || (d.createdByUid is string && d.createdByUid.size() <= 128))
          && (!('createdAt' in d) || d.createdAt is number)
          && (!('updatedAt' in d) || d.updatedAt is number)
          && (!('level' in d) || (d.level is number && d.level >= 1 && d.level <= 10))
          && (!('positions' in d) || positionsOk(d.positions))
          && (!('notes' in d) || notesOk(d.notes))
          && (!('shortName' in d) || (d.shortName is string && d.shortName.size() <= 40));
    }
    function validOrganizer(d) {
      return d.name is string && d.name.size() > 0 && d.name.size() <= 40
          && (!('createdAt' in d) || d.createdAt is number);
    }
    function validUser(d) {
      return (d.role == 'admin' || d.role == 'organizer')
          && d.name is string && d.name.size() > 0 && d.name.size() <= 40
          && d.email is string && d.email.size() > 3 && d.email.size() <= 80
          && d.active is bool
          && (!('createdAt' in d) || d.createdAt is number);
    }
    // Lo que ve alguien sin cuenta. Sin teléfono.
    function validConfirmation(d) {
      return d.playerId is string && d.playerId.size() > 0 && d.playerId.size() <= 80
          && d.matchId is string && d.matchId.size() > 0 && d.matchId.size() <= 80
          && d.name is string && d.name.size() > 0 && d.name.size() <= 60
          && d.date is string && d.date.matches('^\\d{4}-\\d{2}-\\d{2}$')
          && d.time is string && d.time.matches('^\\d{2}:\\d{2}$')
          && (!('note' in d) || (d.note is string && d.note.size() <= 300))
          && (!('confirmed' in d) || d.confirmed == null || d.confirmed == 'si' || d.confirmed == 'no')
          && (!('confirmedAt' in d) || d.confirmedAt == null || d.confirmedAt is number)
          && (!('cancelled' in d) || d.cancelled is bool)
          && (!('notes' in d) || (d.notes is string && d.notes.size() <= 2000))
          && (!('venue' in d) || (d.venue is string && d.venue.size() <= 80));
    }
    function anonymousConfirm() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly(['confirmed', 'confirmedAt'])
          && resource.data.get('cancelled', false) != true
          && request.resource.data.playerId == resource.data.playerId
          && request.resource.data.matchId == resource.data.matchId
          && request.resource.data.name == resource.data.name
          && request.resource.data.date == resource.data.date
          && request.resource.data.time == resource.data.time
          && (request.resource.data.confirmed == 'si' || request.resource.data.confirmed == 'no')
          && request.resource.data.confirmedAt is number;
    }

    match /users/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || isActiveStaff());
      allow list: if isActiveStaff();
      // Alta del primer admin. Solo su propio uid y solo ese mail.
      allow create: if signedIn()
          && request.auth.uid == userId
          && isAdminEmail()
          && validUser(request.resource.data)
          && request.resource.data.role == 'admin'
          && request.resource.data.active == true
          && request.resource.data.email.lower() == request.auth.token.email.lower()
          && !exists(userPath(userId));
      // El admin crea organizadores (el uid es el de la cuenta nueva).
      allow create: if isAdmin()
          && request.auth.uid != userId
          && validUser(request.resource.data)
          && request.resource.data.role == 'organizer'
          && request.resource.data.active == true;
      // Desactivar o volver a activar. El rol, el mail y el nombre quedan iguales.
      allow update: if isAdmin()
          && userId != request.auth.uid
          && resource.data.role == 'organizer'
          && validUser(request.resource.data)
          && request.resource.data.role == 'organizer'
          && request.resource.data.email == resource.data.email
          && request.resource.data.name == resource.data.name
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active']);
      allow delete: if isAdmin()
          && userId != request.auth.uid
          && resource.data.role == 'organizer';
    }

    match /matches/{matchId} {
      // get acepta partidos viejos sin viewers. list solo la consulta
      // array-contains-any [uid, '*']: si no, Firestore rechaza la lista.
      allow get: if isActiveStaff() && canReadListed(resource.data);
      allow list: if isActiveStaff() && resource.data.viewers.hasAny([request.auth.uid, '*']);
      allow create: if isActiveStaff() && validMatch(request.resource.data);
      allow update: if isActiveStaff() && validMatch(request.resource.data) && isViewer(resource.data)
          && (isCreator() || (accessSame() && isAdder(resource.data)) || legacyStamp());
      // playerCount lo mantiene quien anota o quita jugadores. Si el campo no
      // está, vale 0 y un partido viejo se puede borrar. La regla no puede
      // contar los documentos de players: quien edita el partido podría
      // poner el contador en 0 y después borrarlo.
      allow delete: if isActiveStaff()
          && ((isPublic(resource.data) && isAdder(resource.data)) || isCreator())
          && resource.data.get('playerCount', 0) == 0;
    }

    function invitedByUnchanged() {
      return resource != null && (
        (!('invitedBy' in request.resource.data) && !('invitedBy' in resource.data))
        || ('invitedBy' in request.resource.data && 'invitedBy' in resource.data
            && request.resource.data.invitedBy == resource.data.invitedBy)
      );
    }
    // Anfitrión nuevo: un jugador del mismo partido que no sea invitado.
    // Si el vínculo no cambia, un invitado-de-invitado ya cargado se puede editar.
    function hostData() {
      return get(/databases/$(database)/documents/players/$(request.resource.data.invitedBy)).data;
    }
    function hostIsMainPlayer() {
      return exists(/databases/$(database)/documents/players/$(request.resource.data.invitedBy))
          && hostData().matchId == request.resource.data.matchId
          && (!('invitedBy' in hostData()) || !(hostData().invitedBy is string) || hostData().invitedBy.size() == 0);
    }
    function invitedByOk() {
      return !('invitedBy' in request.resource.data) || invitedByUnchanged() || hostIsMainPlayer();
    }

    match /players/{playerId} {
      allow get: if isActiveStaff() && canReadListed(resource.data);
      allow list: if isActiveStaff() && resource.data.viewers.hasAny([request.auth.uid, '*']);
      allow create: if isActiveStaff() && validPlayer(request.resource.data)
          && invitedByOk()
          && isAdder(matchData(request.resource.data.matchId))
          && playerListsOk(request.resource.data.matchId);
      // Solo el pago (Guardar pago, pago dividido, promo, cobrar transferencia).
      // Va primero y es corta: nombre, teléfono, invitado, respuesta y acceso
      // no cambian, así que no hace falta revisarlos. Firestore corta en la
      // primera regla que da true; la larga de abajo, más el cierre del admin,
      // pasaban el tope de 1000 expresiones con un invitado.
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(moneyKeys().concat(['updatedAt']))
          && isActiveStaff()
          && (!('adders' in resource.data) || resource.data.adders.hasAny([request.auth.uid, '*']))
          && phoneGone(request.resource.data)
          && validMoney(request.resource.data);
      allow update: if isActiveStaff() && validPlayerUpdate() && invitedByOk() && confirmationWriteOk()
          && playerStampSame()
          && (playerNameSame() || isPlayerCreator())
          && (playerPhoneMetaSame() || isPlayerCreator() || legacyPhoneMoveOk())
          && (
            (
              (!('adders' in resource.data) || resource.data.adders.hasAny([request.auth.uid, '*']))
              && playerAccessUnchanged()
            )
            || playerFollowsMatch()
          );
      allow delete: if isActiveStaff() && (!('adders' in resource.data) || resource.data.adders.hasAny([request.auth.uid, '*']));
    }

    match /roster/{rosterId} {
      // El borrado no puede mirar players: las reglas no consultan otra
      // colección. La app rechaza el borrado si esa ficha está anotada.
      allow read, delete: if isActiveStaff();
      allow create: if isActiveStaff() && validRoster(request.resource.data);
      allow update: if isActiveStaff() && validRoster(request.resource.data)
          && rosterStampSame()
          && (rosterIdentitySame() || isRosterCreator());
    }

    function validVenue(d) {
      return d.name is string && d.name.size() > 0 && d.name.size() <= 80
          && d.active is bool
          && d.order is int && d.order >= 0 && d.order <= 999
          && (!('createdAt' in d) || d.createdAt is number);
    }

    match /venues/{venueId} {
      allow read: if isActiveStaff();
      allow create, update: if isActiveStaff()
          && venueId.matches('^[a-z0-9][a-z0-9-]{0,39}$')
          && validVenue(request.resource.data);
      allow delete: if false;
    }

    match /organizers/{organizerId} {
      allow read, delete: if isActiveStaff();
      allow create, update: if isActiveStaff() && validOrganizer(request.resource.data);
    }

    match /settings/{docId} {
      allow read: if isActiveStaff() && docId == 'prices';
      allow create, update: if isActiveStaff() && docId == 'prices' && validPrices(request.resource.data);
      allow delete: if isActiveStaff() && docId == 'prices';
    }

    // El id es el token del link. Se puede leer UN documento si se conoce el
    // id; no se puede listar la colección. No tiene teléfonos.
    match /confirmations/{token} {
      allow get: if token.size() >= 16 && token.size() <= 80;
      allow list: if isActiveStaff() && resource.data.viewers.hasAny([request.auth.uid, '*']);
      allow create: if isActiveStaff() && validConfirmation(request.resource.data);
      allow update: if isActiveStaff() && validConfirmation(request.resource.data) && confirmationViewersOk();
      allow update: if token.size() >= 16 && token.size() <= 80
          && validConfirmation(request.resource.data)
          && anonymousConfirm();
      allow delete: if isActiveStaff();
    }

    function contactPhoneOk(d) {
      return d.phone is string && d.phone.size() > 0 && d.phone.size() <= 20
          && d.ownerUid is string && d.ownerUid.size() > 0 && d.ownerUid.size() <= 128
          && d.visibleToAll is bool
          && d.phoneKey is string && d.phoneKey.size() == 64 && d.phoneKey.matches('^[0-9a-f]{64}$');
    }
    function validPlayerContact(d) {
      return contactPhoneOk(d)
          && d.viewers is list && d.viewers.size() > 0 && d.viewers.size() <= 30;
    }
    function validRosterContact(d) {
      return contactPhoneOk(d);
    }
    function playerPath(playerId) {
      return /databases/$(database)/documents/players/$(playerId);
    }
    function rosterPath(rosterId) {
      return /databases/$(database)/documents/roster/$(rosterId);
    }
    function contactViewersFollow(playerId) {
      return request.resource.data.viewers == get(playerPath(playerId)).data.get('viewers', ['*']);
    }
    // El teléfono no está en players ni en roster. Estas dos colecciones
    // lo guardan. Sin visibleToAll solo lo lee ownerUid. El admin no entra.
    match /playerContacts/{playerId} {
      allow get: if isActiveStaff() && (
        resource.data.ownerUid == request.auth.uid
        || (resource.data.visibleToAll == true && canReadListed(resource.data))
      );
      allow list: if isActiveStaff() && resource.data.ownerUid == request.auth.uid;
      allow list: if isActiveStaff() && resource.data.visibleToAll == true
          && resource.data.viewers.hasAny([request.auth.uid, '*']);
      allow create: if isActiveStaff() && validPlayerContact(request.resource.data)
          && exists(playerPath(playerId))
          && contactViewersFollow(playerId)
          && request.resource.data.ownerUid == request.auth.uid
          && get(playerPath(playerId)).data.get('addedByUid', '') == request.auth.uid;
      allow create: if isActiveStaff() && validPlayerContact(request.resource.data)
          && exists(playerPath(playerId))
          && contactViewersFollow(playerId)
          && request.resource.data.visibleToAll == false
          && get(playerPath(playerId)).data.get('phone', '') == request.resource.data.phone
          && get(playerPath(playerId)).data.get('phone', '').size() > 0
          && (
            request.resource.data.ownerUid == get(playerPath(playerId)).data.get('addedByUid', '')
            || (
              get(playerPath(playerId)).data.get('addedByUid', '') == ''
              && request.resource.data.ownerUid == request.auth.uid
              && get(playerPath(playerId)).data.addedBy is string
              && userData().name is string
              && get(playerPath(playerId)).data.addedBy.lower() == userData().name.lower()
            )
          );
      allow update: if isActiveStaff() && validPlayerContact(request.resource.data)
          && resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == resource.data.ownerUid
          && contactViewersFollow(playerId);
      allow update: if isActiveStaff() && validPlayerContact(request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewers'])
          && exists(playerPath(playerId))
          && contactViewersFollow(playerId)
          && isAdder(matchData(get(playerPath(playerId)).data.matchId));
      allow delete: if isActiveStaff() && resource.data.ownerUid == request.auth.uid;
      allow delete: if isActiveStaff() && !exists(playerPath(playerId));
      allow delete: if isActiveStaff() && exists(playerPath(playerId))
          && isAdder(matchData(get(playerPath(playerId)).data.matchId));
    }

    match /rosterContacts/{rosterId} {
      allow get: if isActiveStaff() && (
        resource.data.ownerUid == request.auth.uid
        || resource.data.visibleToAll == true
      );
      allow list: if isActiveStaff() && resource.data.ownerUid == request.auth.uid;
      allow list: if isActiveStaff() && resource.data.visibleToAll == true;
      allow create: if isActiveStaff() && validRosterContact(request.resource.data)
          && exists(rosterPath(rosterId))
          && request.resource.data.ownerUid == request.auth.uid
          && (
            get(rosterPath(rosterId)).data.get('createdByUid', '') == request.auth.uid
            || get(rosterPath(rosterId)).data.get('phoneOwnerUid', '') == request.auth.uid
          );
      allow create: if isActiveStaff() && validRosterContact(request.resource.data)
          && exists(rosterPath(rosterId))
          && request.resource.data.visibleToAll == false
          && get(rosterPath(rosterId)).data.get('phone', '') == request.resource.data.phone
          && get(rosterPath(rosterId)).data.get('phone', '').size() > 0
          && (
            request.resource.data.ownerUid == get(rosterPath(rosterId)).data.get('createdByUid', '')
            || (
              get(rosterPath(rosterId)).data.get('createdByUid', '') == ''
              && request.resource.data.ownerUid == request.auth.uid
              && get(rosterPath(rosterId)).data.createdBy is string
              && userData().name is string
              && get(rosterPath(rosterId)).data.createdBy.lower() == userData().name.lower()
            )
          );
      allow update: if isActiveStaff() && validRosterContact(request.resource.data)
          && resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if isActiveStaff();
    }

    // El id es el código corto (8, base62). Apunta al mismo m, p y t del link largo.
    // Se lee un documento si se conoce el id. No se lista.
    function validShortLink(d) {
      return d.m is string && d.m.size() > 0 && d.m.size() <= 80
          && d.p is string && d.p.size() > 0 && d.p.size() <= 80
          && d.t is string && d.t.size() >= 16 && d.t.size() <= 80;
    }
    function validExternalShort(d) {
      return d.shortAt is number
          && d.shortUrl is string
          && d.shortUrl.size() <= 80
          && (
            (d.shortProvider == 'spoo' && d.shortUrl.matches('^https://spoo\\.me/[A-Za-z0-9_]+$'))
            || (d.shortProvider == 'dagd' && d.shortUrl.matches('^https://da\\.gd/[A-Za-z0-9_]+$'))
          );
    }
    match /links/{code} {
      allow get: if code.size() == 8 && code.matches('^[0-9A-Za-z]{8}$');
      // El alta sigue siendo solo m, p y t. El acortador se guarda después.
      allow create: if isActiveStaff() && validShortLink(request.resource.data)
          && code.size() == 8 && code.matches('^[0-9A-Za-z]{8}$')
          && request.resource.data.keys().hasOnly(['m', 'p', 't']);
      // Solo se pueden tocar shortUrl, shortProvider y shortAt. m, p y t quedan iguales.
      allow update: if isActiveStaff()
          && code.size() == 8 && code.matches('^[0-9A-Za-z]{8}$')
          && validShortLink(request.resource.data)
          && validExternalShort(request.resource.data)
          && request.resource.data.m == resource.data.m
          && request.resource.data.p == resource.data.p
          && request.resource.data.t == resource.data.t
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['shortUrl', 'shortProvider', 'shortAt']);
      allow delete: if isActiveStaff();
    }

    // Saldo a favor de un jugador con un organizador. Colección aparte: no
    // entra en el update de players, así no suma al tope de 1000 expresiones.
    function validCredit(d) {
      return d.keys().hasOnly(['personKey', 'organizerUid', 'organizerName', 'amount', 'name', 'updatedAt', 'updatedBy'])
          && d.personKey is string && d.personKey.size() > 0 && d.personKey.size() <= 300
          && d.organizerUid is string && d.organizerUid.size() > 0 && d.organizerUid.size() <= 128
          && d.organizerName is string && d.organizerName.size() > 0 && d.organizerName.size() <= 40
          && d.amount is number && d.amount >= 0 && d.amount <= 1000000000
          && d.name is string && d.name.size() <= 60
          && d.updatedAt is number
          && d.updatedBy is string && d.updatedBy.size() <= 40;
    }
    match /credits/{creditId} {
      allow read: if isActiveStaff();
      allow create, update: if isActiveStaff() && validCredit(request.resource.data)
          && creditId.size() > 0 && creditId.size() <= 700;
      allow delete: if isActiveStaff();
    }

    // Backup, carga y reset. isAdmin() exige cuenta activa con role == admin.
    // Un organizador no entra: sigue sin ver un Solo yo ajeno ni un teléfono privado.
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
