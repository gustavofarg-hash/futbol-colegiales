rules_version = '2';

// Reglas v1: ABIERTAS para partidos y jugadores. Las colecciones roster y
// organizers son nuevas: las reglas YA PUBLICADAS las rechazan (el cierre de
// abajo). Hay que republicar este archivo para que Jugadores, el perfil y la
// lista de organizadores funcionen en Firebase. Hasta entonces la app avisa en
// español, el selector sigue con Gustavo y Martín, y el resto sigue andando.
// receivedBy en el jugador es un campo extra: se puede escribir sin republicar.
service cloud.firestore {
  match /databases/{database}/documents {

    function validMatch(d) {
      return d.date is string && d.date.matches('^\\d{4}-\\d{2}-\\d{2}$')
          && d.time is string && d.time.matches('^\\d{2}:\\d{2}$')
          && (!('note' in d) || (d.note is string && d.note.size() <= 300));
    }

    // Pago opcional en el mismo documento del jugador.
    // Las reglas YA PUBLICADAS no miran estos campos (validPlayer solo exige
    // matchId, name y phone, y deja pasar campos extra). La app escribe
    // valores que cumplen esa versión publicada. validPayment entra en
    // vigencia recién cuando se vuelvan a publicar estas reglas.
    function validPayment(d) {
      return (!('paid' in d) || d.paid is bool)
          && (!('amount' in d) || d.amount == null || (d.amount is number && d.amount >= 0 && d.amount <= 1000000000))
          && (!('method' in d) || d.method == null || d.method == 'efectivo' || d.method == 'transferencia')
          && (!('paidUpdatedBy' in d) || (d.paidUpdatedBy is string && d.paidUpdatedBy.size() <= 40))
          && (!('paidUpdatedAt' in d) || d.paidUpdatedAt is number)
          && (!('receivedBy' in d) || d.receivedBy == null || (d.receivedBy is string && d.receivedBy.size() > 0 && d.receivedBy.size() <= 40))
          && (!('waiting' in d) || d.waiting is bool)
          && (!('waitOrder' in d) || d.waitOrder == null || (d.waitOrder is number && d.waitOrder >= 0 && d.waitOrder <= 1000000))
          && (!('rosterAt' in d) || d.rosterAt == null || d.rosterAt is number)
          && (!('confirmToken' in d) || (d.confirmToken is string && d.confirmToken.size() >= 16 && d.confirmToken.size() <= 80))
          && (!('confirmed' in d) || d.confirmed == null || d.confirmed == 'si' || d.confirmed == 'no')
          && (!('confirmedAt' in d) || d.confirmedAt == null || d.confirmedAt is number)
          && (!('reminderSentAt' in d) || d.reminderSentAt == null || d.reminderSentAt is number);
    }

    // Si cambian la confirmación, el update solo puede tocar confirmed,
    // confirmedAt y updatedAt, y el token del documento tiene que seguir igual.
    // No es un secreto frente a quien puede leer el jugador (las lecturas
    // siguen abiertas): evita que un update cualquiera pise la respuesta.
    // La app ya escribe así. Esto recién se exige al republicar las reglas.
    function confirmationWriteOk() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return !changed.hasAny(['confirmed', 'confirmedAt'])
          || (changed.hasOnly(['confirmed', 'confirmedAt', 'updatedAt'])
              && request.resource.data.confirmToken == resource.data.confirmToken
              && request.resource.data.confirmToken is string
              && request.resource.data.confirmToken.size() >= 16
              && (request.resource.data.confirmed == 'si' || request.resource.data.confirmed == 'no')
              && request.resource.data.confirmedAt is number);
    }

    function validPlayer(d) {
      return d.matchId is string && d.name is string
          && d.name.size() > 0 && d.name.size() <= 60
          && d.phone is string && d.phone.size() <= 20
          && validPayment(d);
    }

    match /matches/{matchId} {
      allow read, delete: if true;
      allow create, update: if validMatch(request.resource.data);
    }

    match /players/{playerId} {
      // La lectura queda abierta a propósito: un aviso externo (REST, con la
      // clave web pública) tiene que poder leer jugadores y armar los links.
      allow read, delete: if true;
      allow create: if validPlayer(request.resource.data);
      allow update: if validPlayer(request.resource.data) && confirmationWriteOk();
    }

    function posOk(x) {
      return x == 'Arquero' || x == 'Defensa' || x == 'Mediocampo' || x == 'Ataque';
    }
    function positionsOk(p) {
      return p is list && p.size() <= 4
          && (p.size() < 1 || posOk(p[0]))
          && (p.size() < 2 || posOk(p[1]))
          && (p.size() < 3 || posOk(p[2]))
          && (p.size() < 4 || posOk(p[3]));
    }
    function noteOk(n) {
      return n is map
          && n.id is string && n.id.size() > 0 && n.id.size() <= 40
          && n.matchId is string && n.matchId.size() > 0 && n.matchId.size() <= 80
          && n.text is string && n.text.size() > 0 && n.text.size() <= 400
          && n.createdAt is number
          && (!('matchDate' in n) || (n.matchDate is string && n.matchDate.size() <= 10))
          && (!('matchTime' in n) || (n.matchTime is string && n.matchTime.size() <= 5))
          && (!('updatedAt' in n) || n.updatedAt is number);
    }
    function notesOk(n) {
      return n is list && n.size() <= 20
          && (n.size() < 1 || noteOk(n[0])) && (n.size() < 2 || noteOk(n[1]))
          && (n.size() < 3 || noteOk(n[2])) && (n.size() < 4 || noteOk(n[3]))
          && (n.size() < 5 || noteOk(n[4])) && (n.size() < 6 || noteOk(n[5]))
          && (n.size() < 7 || noteOk(n[6])) && (n.size() < 8 || noteOk(n[7]))
          && (n.size() < 9 || noteOk(n[8])) && (n.size() < 10 || noteOk(n[9]))
          && (n.size() < 11 || noteOk(n[10])) && (n.size() < 12 || noteOk(n[11]))
          && (n.size() < 13 || noteOk(n[12])) && (n.size() < 14 || noteOk(n[13]))
          && (n.size() < 15 || noteOk(n[14])) && (n.size() < 16 || noteOk(n[15]))
          && (n.size() < 17 || noteOk(n[16])) && (n.size() < 18 || noteOk(n[17]))
          && (n.size() < 19 || noteOk(n[18])) && (n.size() < 20 || noteOk(n[19]));
    }
    function validRoster(d) {
      return d.name is string && d.name.size() > 0 && d.name.size() <= 60
          && d.phone is string && d.phone.size() <= 20
          && (!('createdBy' in d) || (d.createdBy is string && d.createdBy.size() <= 40))
          && (!('createdAt' in d) || d.createdAt is number)
          && (!('updatedAt' in d) || d.updatedAt is number)
          && (!('level' in d) || (d.level is int && d.level >= 1 && d.level <= 10))
          && (!('positions' in d) || positionsOk(d.positions))
          && (!('notes' in d) || notesOk(d.notes));
    }

    // Plantel guardado (pantalla Jugadores). Lectura abierta, igual que el resto.
    // Recién vale cuando se republican las reglas.
    match /roster/{rosterId} {
      allow read, delete: if true;
      allow create, update: if validRoster(request.resource.data);
    }

    function validOrganizer(d) {
      return d.name is string && d.name.size() > 0 && d.name.size() <= 40
          && (!('createdAt' in d) || d.createdAt is number);
    }

    // Quién cobra y quién aparece en "¿Quién sos?". Id estable (gustavo, martin).
    // La app solo agrega. Recién vale cuando se republican las reglas.
    match /organizers/{organizerId} {
      allow read, delete: if true;
      allow create, update: if validOrganizer(request.resource.data);
    }

    // Todo lo demás, cerrado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
